programa{
    funcao inicio()
    {
      
        inteiro largura, altura, base
        inteiro somatorio

        escreva("Digite a largura (DataIn): ")
        leia(largura)

        escreva("Digite a altura (DataIn): ")
        leia(altura)

        escreva("Digite a base (DataIn): ")
        leia(base)

        somatorio = 4 * (largura + altura + base)

        escreva("\nSoma total das arestas: ",somatorio,"\n")
    }
}